<launch>
  <!-- Usa tempo simulato del rosbag -->
  <param name="use_sim_time" value="true" />

  <!-- Nodo 1: odometer (vehicle) -->
  <node pkg="first_project" type="odometer" name="odometer_node" output="screen" />

  <!-- Nodo 2: gps_odometer (GPS) -->
  <node pkg="first_project" type="gps_odometer" name="gps_odometer_node" output="screen" />

  <!-- Nodo 3: sector_times (GPS) -->
  <node pkg="first_project" type="sector_times" name="sector_times_node" output="screen" />

  <!-- Avvia RViz con la configurazione salvata -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find first_project)/rviz/config.rviz" />
</launch>


